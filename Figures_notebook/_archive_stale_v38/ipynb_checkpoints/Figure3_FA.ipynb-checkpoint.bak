      "    DC     1903 0.995                0.822           0.1344             TK1         NFKB1\n",
      "  Mono     2008 0.998                0.062           0.0195         C1QTNF4          SPI1\n",
      "\n",
      "Ery:\n",
      "  Top 5 genes:  ['HBB', 'AHSP', 'CA1', 'FAM178B', 'APOC1', 'FCER1A', 'FAM89A', 'LMNA', 'EPCAM', 'APOE']\n",
