    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[Mono] saved 6/6 panels -> results/figure3_fa/Mono/  (barplot, heatmap, scatter, profiles, summary, network)\n"
     ]
    }
   ],
   "source": [
    "# ── Per-branch regulator plots (Ery / DC / Mono) ──────────────────────────\n",
    "# Six panels per branch:\n",
    "#   barplot · heatmap · scatter · profiles   (the four individual figures)\n",
    "#   regulator_summary  (one 4-panel composite)\n",
    "#   regulator_network  (hybrid graph: solid=reference edges, dashed=de novo)\n",
    "# Each branch writes into its own subfolder so identical filenames don't\n",
    "# overwrite each other. Each call is wrapped in try/except because heatmap /\n",
    "# profiles / summary / network read deep into uns and can fail for branches\n",
    "# with few sensitive windows.\n",
    "for name in branch_models:\n",
    "    reg_key   = f'scjdo_regulators_{name}'    # set above by infer_regulators(key_added=...)\n",
    "    drift_key = f'scjdo_{name}'               # set above by fit_drift_branches\n",
    "    branch_dir = OUTDIR + f'{name}/'\n",
    "    os.makedirs(branch_dir, exist_ok=True)\n",
    "\n",
    "    # Skip cleanly if infer_regulators failed (empty fallback) for this branch\n",
    "    reg_uns = ad.uns.get(reg_key)\n",
    "    if not reg_uns or not reg_uns.get('tables'):\n",
    "        print(f'[{name}] no regulator table — skipping plots')\n",
    "        continue\n",
    "\n",
    "    plots = [\n",
    "        # Four individual panels\n",
    "        ('barplot',  lambda: sjd.pl.regulator_barplot(ad, key=reg_key,\n",
    "                              n_show=20, save=branch_dir + 'reg_barplot.pdf')),\n",
    "        ('heatmap',  lambda: sjd.pl.regulator_heatmap(ad, key=reg_key, scjdo_key=drift_key,\n",
    "                              n_show=15, save=branch_dir + 'reg_heatmap.pdf')),\n",
    "        ('scatter',  lambda: sjd.pl.regulator_scatter(ad, key=reg_key,\n",
    "                              n_label=10, save=branch_dir + 'reg_scatter.pdf')),\n",
    "        ('profiles', lambda: sjd.pl.regulator_profiles(ad, key=reg_key, scjdo_key=drift_key,\n",
    "                              n_tfs=3, save=branch_dir + 'reg_profiles.pdf')),\n",
    "        # Four-panel summary (bar + heatmap + scatter + profiles, one figure)\n",
    "        ('summary',  lambda: sjd.pl.regulator_summary(ad, key=reg_key, scjdo_key=drift_key,\n",
    "                              save=branch_dir + 'regulator_summary.pdf')),\n",
    "        # Hybrid network graph (solid = reference, dashed = de novo co-instability)\n",
    "        ('network',  lambda: sjd.pl.regulator_network(ad, key=reg_key, scjdo_key=drift_key,\n",
    "                              n_tfs=5, n_targets=6, n_denovo=4,\n",
    "                              save=branch_dir + 'regulator_network.pdf')),\n",
    "    ]\n",
    "    ok = []\n",
    "    for label, fn in plots:\n",
    "        try:\n",
    "            fn(); ok.append(label)\n",
    "        except Exception as e:\n",
    "            print(f'  [{name}] {label}: {type(e).__name__}: {e}')\n",
    "    print(f'[{name}] saved {len(ok)}/{len(plots)} panels -> {branch_dir}  ({\", \".join(ok)})')\n"
   ]
  },
