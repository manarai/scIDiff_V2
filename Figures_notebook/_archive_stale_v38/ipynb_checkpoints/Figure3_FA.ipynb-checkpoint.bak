   ],
   "source": [
    "sc.pl.embedding(\n",
    "    ad,\n",
    "    basis=\"umap\",\n",
    "    layer=\"MAGIC_imputed_data\",\n",
    "    color=[\"CD34\", \"MPO\", \"GATA1\", \"IRF8\"],\n",
    "    frameon=False,\n",
    ")\n",
    "plt.show()"
   ]
  },
