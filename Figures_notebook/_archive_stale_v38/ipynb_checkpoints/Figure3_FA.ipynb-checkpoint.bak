  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "66658024",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Cell fate labels (velocity bias prior):\n",
      "cell_fate\n",
      "Mono          2718\n",
      "Progenitor    1036\n",
      "Ery            298\n",
      "DC              90\n"
     ]
    }
   ],
   "source": [
    "# Cell fate labels for velocity bias\n",
    "# High-entropy cells → 'Progenitor'; all others → dominant fate label\n",
    "fate_probs = ad.obsm['palantir_fate_probabilities']\n",
    "ad.obs['cell_fate'] = fate_probs.idxmax(axis=1).astype(str)\n",
    "entropy_thr = ad.obs['palantir_entropy'].quantile(0.75)\n",
    "ad.obs.loc[ad.obs['palantir_entropy'] >= entropy_thr, 'cell_fate'] = 'Progenitor'\n",
    "\n",
    "print('\\nCell fate labels (velocity bias prior):')\n",
    "print(ad.obs['cell_fate'].value_counts().to_string())"
   ]
  },
